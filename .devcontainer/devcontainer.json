{
  "name": "Pôle formation INT",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/pole-formation",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "27"
    }
  },
  "forwardPorts": [5173, 8080],
  "remoteUser": "pwuser",
  "postCreateCommand": "python3 scripts/progress.py install",
  "shutdownAction": "stopCompose"
}
