{
  "name": "pole-formation-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/shared/http/generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {"lit": "3.3.3", "openapi-fetch": "0.17.0"},
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
